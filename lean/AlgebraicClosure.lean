import Mathlib.RingTheory.Algebraic.Integral

/-!
# Closure properties of algebraic elements

This file packages Mathlib's integral-closure and algebraic-tower machinery into a
single reusable development.

The root theorem is proved by a coefficient-generated intermediate subalgebra:
first put all coefficients in the subalgebra they generate, prove that this
subalgebra is algebraic over the base field, regard the given root as algebraic
over that intermediate algebra, and finally restrict scalars back to the base
field.

No axioms, sorry, or admit are introduced here.
-/

namespace AlgebraicNumberClosureFormalization

open Polynomial

/-! ## Addition and multiplication -/

/-- The sum of two elements algebraic over a field is algebraic. -/
theorem isAlgebraic_add
    {K A : Type*} [Field K] [Field A] [Algebra K A]
    {x y : A} (hx : IsAlgebraic K x) (hy : IsAlgebraic K y) :
    IsAlgebraic K (x + y) :=
  hx.add hy

/-- The product of two elements algebraic over a field is algebraic. -/
theorem isAlgebraic_mul
    {K A : Type*} [Field K] [Field A] [Algebra K A]
    {x y : A} (hx : IsAlgebraic K x) (hy : IsAlgebraic K y) :
    IsAlgebraic K (x * y) :=
  hx.mul hy

/-- The algebraic elements form a subalgebra over a field. -/
def algebraicNumbersSubalgebra (K A : Type*) [Field K] [Field A] [Algebra K A] :
    Subalgebra K A :=
  Subalgebra.algebraicClosure K A

@[simp]
theorem mem_algebraicNumbersSubalgebra
    {K A : Type*} [Field K] [Field A] [Algebra K A] {x : A} :
    x ∈ algebraicNumbersSubalgebra K A ↔ IsAlgebraic K x :=
  Subalgebra.mem_algebraicClosure

/-- Closure under addition, expressed internally in the algebraic-number subalgebra. -/
theorem algebraicNumbers_add
    {K A : Type*} [Field K] [Field A] [Algebra K A]
    {x y : A}
    (hx : x ∈ algebraicNumbersSubalgebra K A)
    (hy : y ∈ algebraicNumbersSubalgebra K A) :
    x + y ∈ algebraicNumbersSubalgebra K A :=
  (algebraicNumbersSubalgebra K A).add_mem hx hy

/-- Closure under multiplication, expressed internally in the algebraic-number subalgebra. -/
theorem algebraicNumbers_mul
    {K A : Type*} [Field K] [Field A] [Algebra K A]
    {x y : A}
    (hx : x ∈ algebraicNumbersSubalgebra K A)
    (hy : y ∈ algebraicNumbersSubalgebra K A) :
    x * y ∈ algebraicNumbersSubalgebra K A :=
  (algebraicNumbersSubalgebra K A).mul_mem hx hy

/-! ## Roots of polynomials with algebraic coefficients -/

/--
If every coefficient of a nonzero polynomial over A is algebraic over K,
then every root of that polynomial in A is algebraic over K.

The proof uses the intermediate algebra generated by all polynomial coefficients.
This handles arbitrary finite degree and does not require choosing minimal
polynomials for the coefficients individually.
-/
theorem isAlgebraic_of_root_of_algebraic_coefficients
    {K A : Type*} [Field K] [Field A] [Algebra K A]
    {p : A[X]} {x : A}
    (hp : p ≠ 0)
    (hcoeff : ∀ n : ℕ, IsAlgebraic K (p.coeff n))
    (hroot : aeval x p = 0) :
    IsAlgebraic K x := by
  classical

  -- Put every coefficient in the intermediate algebra it generates.
  let S : Subalgebra K A := Algebra.adjoin K (Set.range p.coeff)

  -- The intermediate algebra is algebraic because each generator is a coefficient of p.
  have hS : S.IsAlgebraic := by
    change (Algebra.adjoin K (Set.range p.coeff)).IsAlgebraic
    rw [Algebra.isAlgebraic_adjoin_iff]
    intro y hy
    rcases hy with ⟨n, rfl⟩
    exact hcoeff n

  letI : Algebra.IsAlgebraic K S :=
    (Subalgebra.isAlgebraic_iff S).mp hS

  -- Re-express p as a polynomial whose coefficients lie in S.
  let q : S[X] :=
    p.toSubring S.toSubring fun c hc => by
      obtain ⟨n, hn, rfl⟩ := mem_coeffs_iff.mp hc
      exact Algebra.subset_adjoin ⟨n, rfl⟩

  have hq_map : q.map (algebraMap S A) = p := by
    simp [q, Subalgebra.algebraMap_eq, ← Subalgebra.toSubring_subtype, map_toSubring]

  have hq_ne_map : q.map (algebraMap S A) ≠ 0 := by
    rw [hq_map]
    exact hp

  have hq_ne : q ≠ 0 :=
    (Polynomial.map_ne_zero_iff (f := algebraMap S A) (p := q)
      Subtype.val_injective).mp hq_ne_map

  -- The original root equation is the evaluation equation for q over the intermediate algebra.
  have hq_root : aeval x q = 0 := by
    rw [← eval_map_algebraMap, hq_map, aeval_def]
    exact hroot

  have hxS : IsAlgebraic S x := ⟨q, hq_ne, hq_root⟩

  -- Algebraicity descends along an algebraic extension of the coefficient algebra.
  exact hxS.restrictScalars K

/-! ## A reusable tower form -/

/--
A root of a polynomial over an algebraic intermediate field is algebraic over
the base field. This is the scalar-descent core used above.
-/
theorem isAlgebraic_of_root_over_algebraic_extension
    {K S A : Type*} [Field K] [Field S] [Field A]
    [Algebra K S] [Algebra S A] [Algebra K A] [IsScalarTower K S A]
    {p : S[X]} {x : A}
    (hp : p ≠ 0)
    (hroot : aeval x p = 0)
    [Algebra.IsAlgebraic K S] :
    IsAlgebraic K x := by
  exact (show IsAlgebraic S x from ⟨p, hp, hroot⟩).restrictScalars K

