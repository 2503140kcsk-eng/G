module
public import EPlusPi
public import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.Algebra.MvPolynomial.CommRing

@[expose] public section

/-!
# Schanuel-conditional consequence for e + π

This module is deliberately separate from the unconditional results.
It states Schanuel's conjecture in its standard transcendence-degree form.
The final theorem is conditional on that conjecture and makes no
unconditional claim.
-/

namespace SchanuelConditional

open scoped IntermediateField.algebraAdjoinAdjoin

/-- The field generated over ℚ by a finite family and its exponentials. -/
noncomputable def generatedField {n : ℕ} (z : Fin n → ℂ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ
    (Set.range z ∪ Set.range (fun i : Fin n => Complex.exp (z i)))

/--
Schanuel's conjecture in its standard form: if zᵢ are linearly independent
over ℚ, then the field generated by zᵢ and exp(zᵢ) has transcendence
degree at least the number of inputs. This is a proposition, not an axiom.
-/
def SchanuelConjecture : Prop :=
  ∀ (n : ℕ) (z : Fin n → ℂ),
    LinearIndependent ℚ z →
    (n : Cardinal) ≤ Algebra.trdeg ℚ (generatedField z)

/-- The two inputs 1 and πi used in the n = 2 specialization. -/
noncomputable def ePiSchanuelInputs : Fin 2 → ℂ :=
  ![(1 : ℂ), (Real.pi : ℂ) * Complex.I]

/-- The pair consisting of e = exp(1) and iπ.  The other exponential
    exp(iπ) = -1 is already rational and adds no generator. -/
noncomputable def ePiSchanuelPair : Fin 2 → ℂ :=
  ![Complex.exp (1 : ℂ), (Real.pi : ℂ) * Complex.I]

@[simp] theorem ePiSchanuelPair_zero :
    ePiSchanuelPair 0 = Complex.exp (1 : ℂ) := rfl

@[simp] theorem ePiSchanuelPair_one :
    ePiSchanuelPair 1 = (Real.pi : ℂ) * Complex.I := rfl

/-- 1 and πi are linearly independent over ℚ: their real and imaginary
    coordinates force the two rational coefficients to vanish. -/
theorem ePiSchanuelInputs_linearIndependent :
    LinearIndependent ℚ ePiSchanuelInputs := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro f hf i
  have hRe := congrArg Complex.re hf
  have hIm := congrArg Complex.im hf
  have h0R : (f 0 : ℝ) = 0 := by
    simpa [ePiSchanuelInputs, Fin.sum_univ_succ] using hRe
  have h1R : (f 1 : ℝ) * Real.pi = 0 := by
    simpa [ePiSchanuelInputs, Fin.sum_univ_succ] using hIm
  have h0 : f 0 = 0 := by exact_mod_cast h0R
  have h1 : f 1 = 0 := by
    rcases mul_eq_zero.mp h1R with h | h
    · exact_mod_cast h
    · exact False.elim (Real.pi_ne_zero h)
  fin_cases i <;> simp [h0, h1]

/-- In this specialization, the field generated by the inputs and their
    exponentials is exactly ℚ(e,πi). -/
theorem generatedField_ePi_eq :
    generatedField ePiSchanuelInputs =
      IntermediateField.adjoin ℚ (Set.range ePiSchanuelPair) := by
  apply le_antisymm
  · rw [generatedField, IntermediateField.adjoin_le_iff]
    rintro x (hx | hx)
    · rcases hx with ⟨i, rfl⟩
      fin_cases i
      · exact one_mem _
      · exact IntermediateField.subset_adjoin ℚ _ ⟨1, by simp [ePiSchanuelInputs, ePiSchanuelPair]⟩
    · rcases hx with ⟨i, rfl⟩
      fin_cases i
      · exact IntermediateField.subset_adjoin ℚ _ ⟨0, by simp [ePiSchanuelInputs, ePiSchanuelPair]⟩
      · change Complex.exp ((Real.pi : ℂ) * Complex.I) ∈
          IntermediateField.adjoin ℚ (Set.range ePiSchanuelPair)
        rw [Complex.exp_pi_mul_I]
        exact neg_mem (one_mem _)
  · rw [IntermediateField.adjoin_le_iff]
    rintro x ⟨i, rfl⟩
    fin_cases i
    · change Complex.exp (1 : ℂ) ∈ generatedField ePiSchanuelInputs
      change Complex.exp (1 : ℂ) ∈
        IntermediateField.adjoin ℚ
          (Set.range ePiSchanuelInputs ∪
            Set.range (fun i : Fin 2 => Complex.exp (ePiSchanuelInputs i)))
      exact IntermediateField.subset_adjoin ℚ _ (Or.inr ⟨0, by simp [ePiSchanuelInputs]⟩)
    · change (Real.pi : ℂ) * Complex.I ∈ generatedField ePiSchanuelInputs
      change (Real.pi : ℂ) * Complex.I ∈
        IntermediateField.adjoin ℚ
          (Set.range ePiSchanuelInputs ∪
            Set.range (fun i : Fin 2 => Complex.exp (ePiSchanuelInputs i)))
      exact IntermediateField.subset_adjoin ℚ _ (Or.inl ⟨1, by simp [ePiSchanuelInputs]⟩)

/-- The field generated by 1, πi and their exponentials. -/
noncomputable def ePiGeneratedField : IntermediateField ℚ ℂ :=
  generatedField ePiSchanuelInputs

theorem ePi_generatedField_trdeg_ge_two (hSC : SchanuelConjecture) :
    (2 : Cardinal) ≤ Algebra.trdeg ℚ ePiGeneratedField := by
  have h := hSC 2 ePiSchanuelInputs ePiSchanuelInputs_linearIndependent
  exact h

/-- Regard e and πi as elements of the Schanuel-generated field. -/
noncomputable def ePiPairInGeneratedField : Fin 2 → ePiGeneratedField :=
  fun i => ⟨ePiSchanuelPair i, by
    classical
    fin_cases i
    · change Complex.exp (1 : ℂ) ∈ generatedField ePiSchanuelInputs
      change Complex.exp (1 : ℂ) ∈
        IntermediateField.adjoin ℚ
          (Set.range ePiSchanuelInputs ∪
            Set.range (fun j : Fin 2 => Complex.exp (ePiSchanuelInputs j)))
      exact IntermediateField.subset_adjoin ℚ _ (Or.inr ⟨0, by simp [ePiSchanuelInputs]⟩)
    · change (Real.pi : ℂ) * Complex.I ∈ generatedField ePiSchanuelInputs
      exact IntermediateField.subset_adjoin ℚ _ (Or.inl ⟨1, by simp [ePiSchanuelInputs]⟩)⟩

/-- The two displayed generators generate the whole subtype field. -/
theorem ePiPairInGeneratedField_adjoin_eq_top :
    IntermediateField.adjoin ℚ (Set.range ePiPairInGeneratedField) = ⊤ := by
  apply IntermediateField.lift_injective ePiGeneratedField
  rw [IntermediateField.lift_adjoin, IntermediateField.lift_top]
  change IntermediateField.adjoin ℚ
    ((fun x : ePiGeneratedField => (x : ℂ)) '' Set.range ePiPairInGeneratedField) =
      generatedField ePiSchanuelInputs
  rw [generatedField_ePi_eq]
  have hset :
      (fun x : ePiGeneratedField => (x : ℂ)) '' Set.range ePiPairInGeneratedField =
        Set.range ePiSchanuelPair := by
    ext z
    constructor
    · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨ePiPairInGeneratedField i, Set.mem_range_self i, rfl⟩
  rw [hset]

/-- The field generated by e and πi is algebraic over itself, expressed
    through the fact that the two displayed elements generate it. -/
theorem ePiPairInGeneratedField_isAlgebraic :
    Algebra.IsAlgebraic
      (Algebra.adjoin ℚ (Set.range ePiPairInGeneratedField))
      ePiGeneratedField := by
  -- The field generated by the pair is the fraction field of the
  -- polynomial subalgebra generated by that pair.
  let B : Subalgebra ℚ ePiGeneratedField :=
    Algebra.adjoin ℚ (Set.range ePiPairInGeneratedField)
  let I : IntermediateField ℚ ePiGeneratedField :=
    IntermediateField.adjoin ℚ (Set.range ePiPairInGeneratedField)
  have hI : I = ⊤ := by
    exact ePiPairInGeneratedField_adjoin_eq_top
  -- Since I = ⊤, its inclusion into ePiGeneratedField is an
  -- isomorphism of B-algebras. Algebraicity transports across it.
  let e : I ≃ₐ[B] ePiGeneratedField :=
    AlgEquiv.ofBijective (IsScalarTower.toAlgHom B I ePiGeneratedField) (by
      constructor
      · intro x y h
        exact Subtype.ext h
      · intro x
        have hx : (x : ePiGeneratedField) ∈ I := by
          rw [hI]
          exact Set.mem_univ x
        exact ⟨⟨x, hx⟩, rfl⟩)
  exact e.isAlgebraic

/-- Schanuel's conjecture implies algebraic independence of e and πi.
    The proof applies the finite transcendence-basis theorem inside the
    field they generate, then maps the result into ℂ. -/
theorem ePi_pair_algebraicIndependent (hSC : SchanuelConjecture) :
    AlgebraicIndependent ℚ ePiSchanuelPair := by
  have htr : (2 : Cardinal) ≤ Algebra.trdeg ℚ ePiGeneratedField :=
    ePi_generatedField_trdeg_ge_two hSC
  letI : Algebra.IsAlgebraic
      (Algebra.adjoin ℚ (Set.range ePiPairInGeneratedField))
      ePiGeneratedField := ePiPairInGeneratedField_isAlgebraic
  have hbasis : IsTranscendenceBasis ℚ ePiPairInGeneratedField :=
    Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite
      ℚ ePiPairInGeneratedField (by simpa using htr)
  have hAIK : AlgebraicIndependent ℚ ePiPairInGeneratedField := hbasis.1
  have hinj : Function.Injective (algebraMap ePiGeneratedField ℂ) := by
    intro x y h
    exact Subtype.ext h
  have hAIC : AlgebraicIndependent ℚ
      (fun i => (ePiPairInGeneratedField i : ℂ)) :=
    hAIK.map' (f := IsScalarTower.toAlgHom ℚ ePiGeneratedField ℂ) hinj
  simpa [ePiPairInGeneratedField] using hAIC
/-- The quadratic field ℚ(i) inside ℂ is algebraic over ℚ. -/
noncomputable def QAdjoinI : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ ({Complex.I} : Set ℂ)

theorem QAdjoinI_isAlgebraic : Algebra.IsAlgebraic ℚ QAdjoinI := by
  change Algebra.IsAlgebraic ℚ
    (IntermediateField.adjoin ℚ ({Complex.I} : Set ℂ))
  rw [IntermediateField.isAlgebraic_adjoin_iff_isAlgebraic]
  intro x hx
  rcases Set.mem_singleton_iff.mp hx with rfl
  exact HermiteLindemannBridge.isAlgebraic_complex_I

/-- Algebraic independence persists after adjoining i, since ℚ(i)/ℚ
    is algebraic. -/
theorem ePi_pair_algebraicIndependent_over_QAdjoinI
    (hSC : SchanuelConjecture) :
    AlgebraicIndependent QAdjoinI ePiSchanuelPair := by
  letI : Algebra.IsAlgebraic ℚ QAdjoinI := QAdjoinI_isAlgebraic
  exact (ePi_pair_algebraicIndependent hSC).extendScalars QAdjoinI

/-- Under Schanuel's conjecture, e + π is transcendental over ℚ. -/
theorem transcendental_ePlusPi_of_schanuel
    (hSC : SchanuelConjecture) : Transcendental ℚ ePlusPi := by
  change ¬ IsAlgebraic ℚ ePlusPi
  intro hsum
  let s : ℂ := Complex.exp (1 : ℂ) + (Real.pi : ℂ)
  have hsumC : IsAlgebraic ℚ s := by
    have hmap : algebraMap ℝ ℂ ePlusPi = s := by
      simp [s, ePlusPi, Complex.ofReal_exp]
    exact hmap ▸ hsum.algebraMap
  let L : IntermediateField ℚ ℂ := QAdjoinI
  letI : Algebra.IsAlgebraic ℚ L := by
    simpa [L] using QAdjoinI_isAlgebraic
  have hsumL : IsAlgebraic L s :=
    hsumC.extendScalars (algebraMap ℚ L).injective
  let M : IntermediateField L ℂ := IntermediateField.adjoin L ({s} : Set ℂ)
  have hMalg : Algebra.IsAlgebraic L M := by
    change Algebra.IsAlgebraic L (IntermediateField.adjoin L ({s} : Set ℂ))
    rw [IntermediateField.isAlgebraic_adjoin_iff_isAlgebraic]
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact hsumL
  letI : Algebra.IsAlgebraic L M := hMalg
  have hAI_M : AlgebraicIndependent M ePiSchanuelPair :=
    (ePi_pair_algebraicIndependent_over_QAdjoinI hSC).extendScalars M
  have hIinL : Complex.I ∈ L := by
    change Complex.I ∈ QAdjoinI
    exact IntermediateField.subset_adjoin ℚ ({Complex.I} : Set ℂ) (by simp)
  let iL : L := ⟨Complex.I, hIinL⟩
  let iM : M := algebraMap L M iL
  let sM : M := ⟨s, IntermediateField.subset_adjoin L ({s} : Set ℂ) (by simp)⟩
  let P : MvPolynomial (Fin 2) M :=
    MvPolynomial.X 0 - MvPolynomial.C sM -
      MvPolynomial.C iM * MvPolynomial.X 1
  have hIpi : Complex.I * ((Real.pi : ℂ) * Complex.I) = -(Real.pi : ℂ) := by
    calc
      Complex.I * ((Real.pi : ℂ) * Complex.I) =
          (Complex.I * (Real.pi : ℂ)) * Complex.I := by rw [mul_assoc]
      _ = ((Real.pi : ℂ) * Complex.I) * Complex.I := by rw [mul_comm Complex.I (Real.pi : ℂ)]
      _ = (Real.pi : ℂ) * (Complex.I * Complex.I) := by rw [← mul_assoc]
      _ = -(Real.pi : ℂ) := by rw [Complex.I_mul_I]; ring
  have hEval : MvPolynomial.aeval ePiSchanuelPair P = 0 := by
    simp [P, ePiSchanuelPair_zero, ePiSchanuelPair_one, s, sM, iM, iL, hIpi]
  have hmon : (Finsupp.single (0 : Fin 2) 1 : Fin 2 →₀ ℕ) ≠ 0 := by
    intro hm
    have hc := congrArg (fun v : Fin 2 →₀ ℕ => v 0) hm
    simp at hc
  let m : Fin 2 →₀ ℕ := Finsupp.single (0 : Fin 2) 1
  have hm : m ≠ 0 := hmon
  have hX0 : (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) M).coeff m = 1 := by
    simp [m]
  have hC : (MvPolynomial.C sM : MvPolynomial (Fin 2) M).coeff m = 0 :=
    MvPolynomial.coeff_C_of_ne_zero hm sM
  have hdegree : (Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) ≠ m := by
    intro h
    have hc := congrArg (fun d : Fin 2 →₀ ℕ => d 1) h
    simp [m] at hc
  have hterm : (MvPolynomial.C iM * MvPolynomial.X (1 : Fin 2) :
      MvPolynomial (Fin 2) M).coeff m = 0 := by
    rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X]
    simp [m, hdegree]
  have hPcoeff : P.coeff m = 1 := by
    simp only [P, MvPolynomial.coeff_sub]
    rw [hX0, hC, hterm]
    simp
  have hPzero : P = 0 := hAI_M.eq_zero_of_aeval_eq_zero P hEval
  have hcoeff0 : P.coeff (Finsupp.single (0 : Fin 2) 1) = 0 := by
    rw [hPzero]
    simp
  exact one_ne_zero (hPcoeff.symm.trans hcoeff0)

