#print axioms ePiSchanuelInputs_linearIndependent
#print axioms ePi_generatedField_trdeg_ge_two
#print axioms ePi_pair_algebraicIndependent
#print axioms ePi_pair_algebraicIndependent_over_QAdjoinI
#print axioms transcendental_ePlusPi_of_schanuel

end SchanuelConditional
