module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.RingTheory.Algebraic.Integral
public import Mathlib.Algebra.Field.Defs

@[expose] public section

/-!
# Finite extensions generated by algebraic elements

This module complements G.AlgebraicElements: the latter packages the
relative algebraic closure as an IntermediateField, while this module
records finite-generation consequences and the finite-dimensionality
criterion for field extensions.

No separability hypothesis is used. The degree-product bound in the
companion handwritten exposition is not asserted here as a Lean theorem.
-/

namespace AlgebraicFieldClosure

variable {F K : Type*} [Field F] [Field K] [Algebra F K]

/-- A finite set of algebraic elements generates a finite-dimensional
intermediate field. IntermediateField.adjoin is the field generated by S. -/
theorem finiteDimensional_adjoin_of_algebraic
    {S : Set K} [Finite S] (hS : ∀ x ∈ S, IsAlgebraic F x) :
    FiniteDimensional F (IntermediateField.adjoin F S) := by
  apply IntermediateField.finiteDimensional_adjoin
  intro x hx
  exact (hS x hx).isIntegral

/-- Every element of a finite-dimensional field extension is algebraic. -/
theorem algebraic_extension_of_finiteDimensional
    [FiniteDimensional F K] :
    Algebra.IsAlgebraic F K :=
  Algebra.IsAlgebraic.of_finite F K

/-- A field extension is finite-dimensional exactly when it is essentially
of finite type and algebraic. For field extensions, the first condition
encodes finite generation as a field. -/
theorem finite_iff_essFiniteType_and_algebraic :
    Module.Finite F K ↔
      Algebra.EssFiniteType F K ∧ Algebra.IsAlgebraic F K := by
  constructor
  · intro h
    let hFinite : Module.Finite F K := h
    exact ⟨inferInstance, inferInstance⟩
  · rintro ⟨hFiniteGeneration, hAlgebraic⟩
    let hFiniteGeneration' : Algebra.EssFiniteType F K := hFiniteGeneration
    let hAlgebraic' : Algebra.IsAlgebraic F K := hAlgebraic
    exact Algebra.finite_of_essFiniteType_of_isAlgebraic

#print axioms finiteDimensional_adjoin_of_algebraic
#print axioms algebraic_extension_of_finiteDimensional
#print axioms finite_iff_essFiniteType_and_algebraic

end AlgebraicFieldClosure
