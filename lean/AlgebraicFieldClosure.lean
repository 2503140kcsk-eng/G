module

import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.RingTheory.Algebraic.Integral

/-!
# Closure properties of algebraic elements and finite extensions

This file packages three classical field-theoretic facts in one reusable
formal development:

* algebraic elements are closed under inversion and integer powers;
* adjoining finitely many algebraic elements gives a finite-dimensional
  intermediate field;
* a field extension is module-finite exactly when it is essentially of
  finite type and algebraic.

No separability hypothesis is used. In Lean, inversion and integer powers
are totalized (0⁻¹ = 0), so the formal inverse and negative-power lemmas
also cover zero. The corresponding textbook statement for negative powers
is normally stated with a nonzero hypothesis.
-/

namespace AlgebraicFieldClosure

variable {F K : Type*} [Field F] [Field K] [Algebra F K]

/-- The inverse of an algebraic element is algebraic. -/
theorem isAlgebraic_inv {x : K} (hx : IsAlgebraic F x) :
    IsAlgebraic F x⁻¹ :=
  hx.inv

/-- Every nonnegative integer power of an algebraic element is algebraic. -/
theorem isAlgebraic_nat_pow {x : K} (hx : IsAlgebraic F x) (n : ℕ) :
    IsAlgebraic F (x ^ n) :=
  (hx.isIntegral.pow n).isAlgebraic

/-- Every integer power of an algebraic element is algebraic.

For negative exponents, Lean uses the totalized field inverse. Under the
usual mathematical convention, assume additionally that x ≠ 0.
-/
theorem isAlgebraic_int_pow {x : K} (hx : IsAlgebraic F x) (n : ℤ) :
    IsAlgebraic F (x ^ n) := by
  cases n with
  | ofNat n =>
      simpa [zpow_ofNat] using (hx.isIntegral.pow n).isAlgebraic
  | negSucc n =>
      rw [zpow_negSucc]
      exact ((hx.isIntegral.pow (n + 1)).isAlgebraic).inv

/-- A finite set of algebraic elements generates a finite-dimensional
intermediate field.

IntermediateField.adjoin is the field generated by the set (not merely
the subalgebra generated by it).
-/
theorem finiteDimensional_adjoin_of_algebraic
    {S : Set K} [Finite S] (hS : ∀ x ∈ S, IsAlgebraic F x) :
    FiniteDimensional F (IntermediateField.adjoin F S) := by
  apply IntermediateField.finiteDimensional_adjoin
  intro x hx
  exact (hS x hx).isIntegral

/-- Every element of a finite-dimensional field extension is algebraic. -/
theorem algebraic_extension_of_finiteDimensional
    [FiniteDimensional F K] : Algebra.IsAlgebraic F K :=
  Algebra.IsAlgebraic.of_finite F K

/-- Finite generation as a field together with algebraicity is equivalent
to finite-dimensionality.

For field extensions, Algebra.EssFiniteType F K is mathlib's representation
of finite generation as a field (via localization).
-/
theorem finite_iff_essFiniteType_and_algebraic :
    Module.Finite F K ↔
      Algebra.EssFiniteType F K ∧ Algebra.IsAlgebraic F K := by
  constructor
  · intro h
    let hFinite : Module.Finite F K := h
    exact ⟨inferInstance, inferInstance⟩
  · rintro ⟨hFiniteGeneration, hAlgebraic⟩
    let hFiniteGeneration' : Algebra.EssFiniteType F K := hFiniteGeneration
    let hAlgebraic' : Algebra.IsAlgebraic F K := hAlgebraic
    exact Algebra.finite_of_essFiniteType_of_isAlgebraic

end AlgebraicFieldClosure

#print axioms AlgebraicFieldClosure.isAlgebraic_inv
#print axioms AlgebraicFieldClosure.isAlgebraic_nat_pow
#print axioms AlgebraicFieldClosure.isAlgebraic_int_pow
#print axioms AlgebraicFieldClosure.finiteDimensional_adjoin_of_algebraic
#print axioms AlgebraicFieldClosure.algebraic_extension_of_finiteDimensional
#print axioms AlgebraicFieldClosure.finite_iff_essFiniteType_and_algebraic
